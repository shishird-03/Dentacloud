<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/plans"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/new_plan"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch"
                android:text="@string/new_plan" />
        </LinearLayout>

        <TextView
            android:id="@+id/plan_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <LinearLayout
            android:id="@+id/items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="vertical" />

        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/add_item" />

        <Spinner
            android:id="@+id/procedure"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/tooth"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch"
                android:layout_weight="1"
                android:hint="@string/tooth_fdi"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="2" />

            <EditText
                android:id="@+id/price"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:hint="@string/estimate_rupees"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/add" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/accept"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch"
                android:layout_weight="1"
                android:text="@string/accept_plan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/defer"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:text="@string/defer_selected" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/done"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch"
                android:layout_weight="1"
                android:text="@string/mark_done" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/invoice"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:text="@string/invoice_selected" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
