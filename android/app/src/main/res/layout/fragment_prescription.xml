<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/favourites" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/favourites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:hint="@string/drug">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/drug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="1"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/dose"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch"
                android:layout_weight="1"
                android:hint="@string/dose"
                android:importantForAutofill="no"
                android:inputType="text" />

            <EditText
                android:id="@+id/days"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:hint="@string/days"
                android:importantForAutofill="no"
                android:inputType="number" />
        </LinearLayout>

        <EditText
            android:id="@+id/frequency"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch"
            android:hint="@string/frequency"
            android:importantForAutofill="no"
            android:inputType="text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch"
            android:text="@string/add_drug" />

        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/prescription" />

        <LinearLayout
            android:id="@+id/items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <EditText
            android:id="@+id/notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:hint="@string/rx_notes"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="@dimen/touch" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/issue"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/issue_and_share" />
    </LinearLayout>
</ScrollView>
