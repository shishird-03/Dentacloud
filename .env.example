# Copy to .env (never commit .env). Every value here is a dummy for local development.

# PostgreSQL: owner runs Flyway migrations, app role is what the API connects as (RLS applies to it)
DB_URL=jdbc:postgresql://localhost:5432/dentacloud
DB_OWNER_USER=dentacloud
DB_OWNER_PASSWORD=dentacloud
DB_APP_USER=dentacloud_app
DB_APP_PASSWORD=dentacloud_app

# JWT signing secret (HS256, at least 32 bytes). Generate: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-change-me

# Field encryption (AES-256-GCM) and blind-index (HMAC) keys, base64 of 32 random bytes each.
# Generate: openssl rand -base64 32
FIELD_ENC_KEY=
BLIND_INDEX_KEY=

# Optional: real reminder delivery. Leave blank to use the logging senders.
FIREBASE_CREDENTIALS=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
